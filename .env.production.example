# Copy to .env.production on the server and fill in real values. Never commit the copy.
# Generate secrets with: openssl rand -hex 32
# Use only letters and digits in MONGO_ROOT_PASSWORD, because it goes inside a connection URL.

# Port on 127.0.0.1 that the host reverse proxy forwards to. Pick one no other project uses.
WEB_PORT=9000

MONGO_ROOT_USER=pscdb
MONGO_ROOT_PASSWORD=

CLIENT_URL=https://servio.servicesground.com
DEFAULT_PKR_PER_USD=277

ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

JWT_ACCESS_SECRET=
OTP_HMAC_SECRET=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=PSCDB

# Stripe test keys for the sandbox; switch to live keys only at go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_SIMULATED_PAYMENTS=false
