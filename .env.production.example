# Copy to .env.production on the server and fill in real values. Never commit the copy.
# Generate secrets with: openssl rand -hex 32
# Use only letters and digits in MONGO_ROOT_PASSWORD, because it goes inside a connection URL.

# Port on 127.0.0.1 that the host reverse proxy forwards to. Pick one no other project uses.
WEB_PORT=9000

# Root account: used only for backups and administration.
MONGO_ROOT_USER=pscdb
MONGO_ROOT_PASSWORD=
# The API's own account, limited to the pscdb database.
MONGO_APP_USER=pscdb_app
MONGO_APP_PASSWORD=

CLIENT_URL=https://pscdb.org

# Domains the server's nginx-proxy routes to this site, and its Docker network.
SITE_HOSTS=pscdb.org,www.pscdb.org
# The Docker network of the server's shared nginx-proxy (on this server it belongs to another project).
PROXY_NETWORK=restaurant-voice-os_default

# MongoDB 8.0 does not start on Linux kernel 6.19 or newer; use a release with the fix.
MONGO_IMAGE=mongo:8.2
DEFAULT_PKR_PER_USD=277

# First superadmin, created on the first start only. Clear ADMIN_PASSWORD after that and use
# scripts/set-admin-password.js to manage accounts.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Stripe test keys for the sandbox; switch to live keys only at go-live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_SIMULATED_PAYMENTS=false
# Test keys (sk_test_) are refused in production unless this is true, for a supervised test only.
STRIPE_TEST_MODE_ACK=false
